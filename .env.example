JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
# Use an Atlas cluster or a MongoDB replica set. Entity writes use transactions to
# atomically advance users.syncVersion and stamp the changed document.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=messenger

# ---------------------------------------------------------------------------
# S3-compatible private avatar storage
# S3_BUCKET is required. S3_REGION defaults to us-east-1.
# S3_ENDPOINT is optional (for S3-compatible services).
# Set both credentials or neither; when omitted the AWS credential chain is used.
# S3_FORCE_PATH_STYLE=true enables path-style addressing.
# ---------------------------------------------------------------------------
S3_BUCKET=messenger-avatars
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# SMTP (registration e-mail verification + password reset)
# Leave SMTP_HOST unset to disable outgoing mail entirely: registration still
# succeeds, /forgot-password answers 503, and accounts simply stay unverified
# (the console shows a reminder with a resend button).
#   SMTP_PORT   defaults to 587 (STARTTLS). Port 465 defaults to implicit TLS.
#   SMTP_SECURE overrides that: 1/true = implicit TLS, 0/false = plain/STARTTLS.
#   SMTP_USER / SMTP_PASSWORD are optional (unauthenticated relay).
#   SMTP_FROM   defaults to `Messenger Cloud <no-reply@APP_BASE_URL-hostname>`.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM="Messenger Cloud <no-reply@example.com>"
